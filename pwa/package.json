{
	"name": "employee-pwa",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "BODY_SIZE_LIMIT=100M node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"generate": "node scripts/generate-strings.mjs && node scripts/generate-icons.mjs",
		"api:types": "npx openapi-typescript@7.13.0 http://localhost:8001/openapi.json -o src/lib/api/schema.d.ts"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"@tabler/icons-webfont": "3.49.0",
		"echarts": "6.1.0",
		"jsqr": "^1.4.0",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^4.10.38"
	},
	"overrides": {
		"cookie": "^0.7.2"
	}
}
