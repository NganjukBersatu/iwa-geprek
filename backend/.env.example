# Copy this file to .env and fill it in. .env is ignored by git and must never be committed.
# Every value below is a placeholder, not a real credential.

# PostgreSQL. A postgres:// or postgresql:// address is accepted; the psycopg driver is added for you.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/app

# Signs the login tokens. At least 32 characters or the app refuses to start.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Public address of this service, used to build every link to an uploaded file, e.g. https://api.example.com (local: http://localhost:8001).
# Required: the service refuses to start without it.
PUBLIC_URL=

# Web origins allowed to call the API from a browser, as a JSON list. Empty = only the apps (no browser).
CORS_ORIGINS=[]

# The interactive API documentation (/docs, /redoc, /openapi.json). Leave false anywhere reachable from the internet.
ENABLE_API_DOCS=false

# Optional cache and live updates. Empty = no cache, every read goes to the database.
REDIS_URL=

# Set by Railway on every deploy; leave empty locally.
RAILWAY_DEPLOYMENT_ID=

# Lowest Android app and browser-app (PWA) versions, as major.minor.patch. Empty = not checked. A lower version is refused with 426.
MIN_VERSION_APK=
MIN_VERSION_PWA=
# Where an outdated app is offered the current version.
DOWNLOAD_URL=
# Mode demo untuk presentasi: true membuat proses ini hanya memakai skema "demo" (isi lewat scripts/demo_data.py isi). Biarkan false untuk data asli.
DEMO_MODE=false

# S3-compatible bucket for uploaded files. Leave empty to keep files in the database.
BUCKET_NAMA=
BUCKET_ENDPOINT=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_REGION=auto
BUCKET_GAYA_ALAMAT=auto
