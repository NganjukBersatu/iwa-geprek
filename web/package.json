{
	"name": "web-frontend",
	"private": true,
	"version": "2.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node scripts/check-colors.mjs && node scripts/check-errors.mjs && node scripts/check-texts.mjs && node scripts/check-brand.mjs",
		"check:colors": "node scripts/check-colors.mjs",
		"check:texts": "node scripts/check-texts.mjs",
		"generate": "node scripts/generate-release.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"api:types": "npx openapi-typescript@7.13.0 http://localhost:8001/openapi.json -o src/lib/api/schema.d.ts"
	},
	"devDependencies": {
		"@skeletonlabs/skeleton": "^5.0.1",
		"@skeletonlabs/skeleton-svelte": "^5.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^26.6.5",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@fontsource/poppins": "^5.3.0",
		"@internationalized/date": "^3.12.3",
		"@sveltejs/adapter-node": "^5.5.4",
		"@tabler/icons-webfont": "3.49.0",
		"@tiptap/core": "2.27.3",
		"@tiptap/extension-placeholder": "2.27.3",
		"@tiptap/extension-task-item": "2.27.3",
		"@tiptap/extension-task-list": "2.27.3",
		"@tiptap/pm": "2.27.3",
		"@tiptap/starter-kit": "2.27.3",
		"echarts": "^6.1.0",
		"leaflet": "^1.9.4"
	},
	"overrides": {
		"cookie": "^0.7.2"
	}
}
